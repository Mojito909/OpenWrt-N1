# 分支必须与 LEDE 源码树代次一致（LEDE 自带的 feeds.conf.default 用 luci;openwrt-25.12）。
# luci 的 master 分支已冻结在 2026-06-08，比 openwrt-25.12 少 38 个插件（含 passwall），
# 与当前主干代码混编会导致插件被 defconfig 静默丢弃甚至编译失败。
src-git packages https://github.com/coolsnowwolf/packages.git
src-git luci https://github.com/coolsnowwolf/luci.git;openwrt-25.12
#src-git luci https://github.com/coolsnowwolf/luci.git;openwrt-24.10
src-git routing https://github.com/coolsnowwolf/routing
#src-git telephony https://github.com/openwrt/telephony.git


#src-git video https://github.com/openwrt/video.git
#src-git targets https://github.com/openwrt/targets.git
#src-git management https://github.com/openwrt-management/packages.git
#src-git oldpackages http://git.openwrt.org/packages.git
#src-git nas https://github.com/linkease/nas-packages.git;master
#src-git nas_luci https://github.com/linkease/nas-packages-luci.git;main
